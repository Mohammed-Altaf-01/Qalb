# Copy to `.env` in this folder (`qalb_mobile/.env`) and set your Next.js app URL.
# Expo inlines `EXPO_PUBLIC_*` at bundle time — restart `npx expo start` after changes.
#
# Physical device on LAN (not localhost — the phone cannot reach your PC as "localhost"):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.42:3000
#
# Production:
# EXPO_PUBLIC_API_BASE_URL=https://your-deployment.vercel.app

EXPO_PUBLIC_API_BASE_URL=
