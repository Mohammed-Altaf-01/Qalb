# Copy to `.env` in this folder (`qalb_mobile/.env`) and set your Next.js app URL.
# Expo inlines `EXPO_PUBLIC_*` at bundle time — restart `npx expo start` after changes.
#
# ── Must match your Next.js / Vercel deployment (single canonical host) ───────
# Mobile sign-in opens: {EXPO_PUBLIC_API_BASE_URL}/api/mobile/auth-complete
# Quran Foundation OAuth redirect must be registered for that SAME host:
#   https://<your-host>/api/auth/callback/quranfoundation
# (Slug matches NEXTAUTH OAuth callback path — see lib/constants/auth.js.)
# On Vercel, set NEXTAUTH_URL or NEXT_PUBLIC_APP_URL to that same origin so OAuth matches.
#
# Physical device on LAN (not localhost — the phone cannot reach your PC as "localhost"):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.42:3000
#
# Production (use your real deployment, not a stale or different Vercel project):
# EXPO_PUBLIC_API_BASE_URL=https://your-deployment.vercel.app

EXPO_PUBLIC_API_BASE_URL=
